@@ -0,0 +1,80 @@
+// SPDX-FileCopyrightText: 2026 NX on Orbis contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// PS4 "color lab" (patch 0030): settings.txt switches to find where the red/blue swap of 3D scenes
+// and videos comes from, and to work around it once it is known. Everything here is off unless
+// settings.txt asks for it.
+//
+//   swapwrite=<tokens>   red and blue are exchanged in what fragment shaders STORE into color
+//                        attachments (and in the color write mask). Tokens, comma separated:
+//                          a8     A8B8G8R8 / A8R8G8B8 (8 bit RGBA) targets
+//                          a2     A2B10G10R10 targets
+//                          r11    B10G11R11 float targets
+//                          f16    R16G16B16A16 float targets
+//                          depth  every color target of a draw that has a depth buffer bound
+//                                 (3D passes; UI and video passes normally have none)
+//                          all    every color target
+//   swapview=<tokens>    red and blue are exchanged in the component mapping of SAMPLED views
+//                        (render-target and depth views are never touched). Tokens:
+//                          a8     A8B8G8R8 / B8G8R8A8 views
+//                          bc     BC1, BC2, BC3, BC6H and BC7 views (not BC4/BC5: not color)
+//                          a2     A2B10G10R10 views
+//                          r11    B10G11R11 views
+//                          f16    R16G16B16A16 float views
+//                          gpu    views of images the GPU has rendered into
+//                          all    every sampled color view
+//
+// Swapping on write is a compensation: whatever later turns the picture around swaps it back.
+#pragma once
+
+#include "common/common_types.h"
+
+namespace Vulkan {
+
+extern int ps4_a2b10_force; // vk_texture_cache.cpp
+extern u32 ps4_swapwrite;   // vk_texture_cache.cpp
+extern u32 ps4_swapview;    // vk_texture_cache.cpp
+
+namespace Ps4ColorLab {
+
+inline constexpr u32 A8 = 1u << 0;
+inline constexpr u32 BC = 1u << 1;
+inline constexpr u32 A2 = 1u << 2;
+inline constexpr u32 R11 = 1u << 3;
+inline constexpr u32 F16 = 1u << 4;
+inline constexpr u32 DEPTH = 1u << 5;
+inline constexpr u32 GPU = 1u << 6;
+inline constexpr u32 ALL = 1u << 7;
+
+/// Should the color attachment with this raw Maxwell RenderTargetFormat get red and blue
+/// exchanged on write? `depth_bound` is whether the draw has a depth buffer.
+[[nodiscard]] inline bool WriteSwap(u8 format, bool depth_bound) {
+    if (ps4_a2b10_force == 2 && format == 0xD1) { // A2B10G10R10_UNORM (a2b10=write)
+        return true;
+    }
+    const u32 mask = ps4_swapwrite;
+    if (mask == 0 || format == 0) { // 0 = NONE
+        return false;
+    }
+    if ((mask & ALL) != 0 || ((mask & DEPTH) != 0 && depth_bound)) {
+        return true;
+    }
+    switch (format) {
+    case 0xCF: // A8R8G8B8_UNORM
+    case 0xD0: // A8R8G8B8_SRGB
+    case 0xD5: // A8B8G8R8_UNORM
+    case 0xD6: // A8B8G8R8_SRGB
+        return (mask & A8) != 0;
+    case 0xD1: // A2B10G10R10_UNORM
+        return (mask & A2) != 0;
+    case 0xE0: // B10G11R11_FLOAT
+        return (mask & R11) != 0;
+    case 0xCA: // R16G16B16A16_FLOAT
+        return (mask & F16) != 0;
+    default:
+        return false;
+    }
+}
+
+} // namespace Ps4ColorLab
+} // namespace Vulkan
