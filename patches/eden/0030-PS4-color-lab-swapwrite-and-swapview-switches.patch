 .../renderer_vulkan/vk_graphics_pipeline.cpp  | 13 ++-
 .../renderer_vulkan/vk_pipeline_cache.cpp     | 16 ++--
 .../renderer_vulkan/vk_texture_cache.cpp      | 35 ++++++++
