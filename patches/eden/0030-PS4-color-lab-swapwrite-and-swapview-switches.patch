 // Exactly one of them should turn MK8D's red/blue-swapped images right if the swap happens on
 // that side; both at once cancel out.
 int ps4_a2b10_force = 0;
+// Color lab (patch 0030, settings.txt swapwrite= / swapview=): bit masks of Ps4ColorLab tokens.
+u32 ps4_swapwrite = 0;
+u32 ps4_swapview = 0;
 // Component mappings, measured at startup (Ps4SwizzleSelfTest): for each permutation of R,G,B,A
 // that a guest view asks for on an 8-bit RGBA image, the mapping to hand the driver instead so
 // that it samples what was asked. Empty when the driver applies every permutation correctly.
@@ -3512,6 +3516,37 @@ ImageView::ImageView(TextureCacheRuntime& runtime, const VideoCommon::ImageViewI
             std::ranges::transform(swizzle, swizzle.begin(), SwapBlueRed);
         }
     }
+    if (ps4_swapview != 0 && !info.IsRenderTarget() &&
+        (aspect_mask & (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)) == 0) {
+        // Color lab (patch 0030): swapview= tokens, see ps4_color_lab.h.
+        const VkFormat vkf = format_info.format;
+        const u32 mask = ps4_swapview;
+        bool swap = (mask & Ps4ColorLab::ALL) != 0;
+        if (!swap && (mask & Ps4ColorLab::A8) != 0) {
+            swap = vkf == VK_FORMAT_A8B8G8R8_UNORM_PACK32 ||
+                   vkf == VK_FORMAT_A8B8G8R8_SRGB_PACK32 || vkf == VK_FORMAT_B8G8R8A8_UNORM ||
+                   vkf == VK_FORMAT_B8G8R8A8_SRGB;
+        }
+        if (!swap && (mask & Ps4ColorLab::BC) != 0) {
+            swap = (vkf >= VK_FORMAT_BC1_RGB_UNORM_BLOCK && vkf <= VK_FORMAT_BC3_SRGB_BLOCK) ||
+                   (vkf >= VK_FORMAT_BC6H_UFLOAT_BLOCK && vkf <= VK_FORMAT_BC7_SRGB_BLOCK);
+        }
+        if (!swap && (mask & Ps4ColorLab::A2) != 0) {
+            swap = vkf == VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+        }
+        if (!swap && (mask & Ps4ColorLab::R11) != 0) {
+            swap = vkf == VK_FORMAT_B10G11R11_UFLOAT_PACK32;
+        }
+        if (!swap && (mask & Ps4ColorLab::F16) != 0) {
+            swap = vkf == VK_FORMAT_R16G16B16A16_SFLOAT;
+        }
+        if (!swap && (mask & Ps4ColorLab::GPU) != 0) {
+            swap = True(image.flags & ImageFlagBits::GpuModified);
+        }
+        if (swap) {
+            std::ranges::transform(swizzle, swizzle.begin(), SwapBlueRed);
+        }
+    }
 #endif
