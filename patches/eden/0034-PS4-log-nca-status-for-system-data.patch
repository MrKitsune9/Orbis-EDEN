From 1070d87e4690a7206a9ffc3ef41162b73fac12cf Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 12 Oct 2026 19:03:53 -0300
Subject: [PATCH] PS4: log the NCA load status when a system data archive
 cannot be opened

---
 src/core/hle/service/filesystem/fsp/fsp_srv.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/core/hle/service/filesystem/fsp/fsp_srv.cpp b/src/core/hle/service/filesystem/fsp/fsp_srv.cpp
index f8ee292..0509400 100644
--- a/src/core/hle/service/filesystem/fsp/fsp_srv.cpp
+++ b/src/core/hle/service/filesystem/fsp/fsp_srv.cpp
@@ -495,6 +495,22 @@ Result FSP_SRV::OpenDataStorageByDataId(OutInterface<IStorage> out_interface,
                     "registered entry present={}; falling back to the built-in placeholder if any",
                     title_id, storage_id,
                     content_provider.HasEntry(title_id, FileSys::ContentRecordType::Data));
+        {
+            const auto nca = romfs_controller->OpenBaseNca(title_id, storage_id,
+                                                           FileSys::ContentRecordType::Data);
+            if (nca == nullptr) {
+                LOG_WARNING(Service_FS,
+                            "PS4: data title {:016X}: no NCA in storage {:02X} (file missing or "
+                            "unreadable there)",
+                            title_id, storage_id);
+            } else {
+                LOG_WARNING(Service_FS,
+                            "PS4: data title {:016X}: NCA found, load status code {} (0 = ok), "
+                            "romfs {}",
+                            title_id, static_cast<int>(nca->GetStatus()),
+                            nca->GetRomFS() != nullptr ? "present" : "missing");
+            }
+        }
 #endif
         const auto archive = FileSys::SystemArchive::SynthesizeSystemArchive(title_id);
 
