From 16ad4ff65c7ea3854b0b70c3353040b6e0af659d Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Wed, 14 Oct 2026 19:02:57 -0300
Subject: [PATCH] PS4: color lab: a8ul and a8uw swapview tokens (large / strip
 UNORM 8 bit views)

---
 src/video_core/renderer_vulkan/ps4_color_lab.h      |  4 ++++
 src/video_core/renderer_vulkan/vk_texture_cache.cpp | 10 ++++++++++
 2 files changed, 14 insertions(+)

diff --git a/src/video_core/renderer_vulkan/ps4_color_lab.h b/src/video_core/renderer_vulkan/ps4_color_lab.h
index 20afe7e..5a5a17e 100644
--- a/src/video_core/renderer_vulkan/ps4_color_lab.h
+++ b/src/video_core/renderer_vulkan/ps4_color_lab.h
@@ -19,6 +19,8 @@
 //                          a8     A8B8G8R8 / B8G8R8A8 views
 //                          a8s    A8B8G8R8 / B8G8R8A8 sRGB views only
 //                          a8u    A8B8G8R8 / B8G8R8A8 UNORM views only
+//                          a8ul   A8B8G8R8 / B8G8R8A8 UNORM views at least 640 pixels wide
+//                          a8uw   A8B8G8R8 / B8G8R8A8 UNORM views that are wide strips (width >= 4x height, >= 200)
 //                          bc     BC1, BC2, BC3, BC6H and BC7 views (not BC4/BC5: not color)
 //                          bc1    BC1 views only (RGB and RGBA, UNORM and sRGB)
 //                          bc3    BC2 and BC3 views only
@@ -59,6 +61,8 @@ inline constexpr u32 BC7 = 1u << 11;
 inline constexpr u32 BCSRGB = 1u << 12;
 inline constexpr u32 A8S = 1u << 13;
 inline constexpr u32 A8U = 1u << 14;
+inline constexpr u32 A8UL = 1u << 15;
+inline constexpr u32 A8UW = 1u << 16;
 
 /// Should the color attachment with this raw Maxwell RenderTargetFormat get red and blue
 /// exchanged on write? `depth_bound` is whether the draw has a depth buffer.
diff --git a/src/video_core/renderer_vulkan/vk_texture_cache.cpp b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
index b4e75d6..4cde841 100644
--- a/src/video_core/renderer_vulkan/vk_texture_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
@@ -3533,6 +3533,16 @@ ImageView::ImageView(TextureCacheRuntime& runtime, const VideoCommon::ImageViewI
         if (!swap && (mask & Ps4ColorLab::A8U) != 0) {
             swap = vkf == VK_FORMAT_A8B8G8R8_UNORM_PACK32 || vkf == VK_FORMAT_B8G8R8A8_UNORM;
         }
+        const bool a8_unorm =
+            vkf == VK_FORMAT_A8B8G8R8_UNORM_PACK32 || vkf == VK_FORMAT_B8G8R8A8_UNORM;
+        const u32 view_w = image.info.size.width;
+        const u32 view_h = image.info.size.height;
+        if (!swap && (mask & Ps4ColorLab::A8UL) != 0) {
+            swap = a8_unorm && view_w >= 640;
+        }
+        if (!swap && (mask & Ps4ColorLab::A8UW) != 0) {
+            swap = a8_unorm && view_w >= 200 && view_w >= 4 * view_h;
+        }
         if (!swap && (mask & Ps4ColorLab::BC) != 0) {
             swap = (vkf >= VK_FORMAT_BC1_RGB_UNORM_BLOCK && vkf <= VK_FORMAT_BC3_SRGB_BLOCK) ||
                    (vkf >= VK_FORMAT_BC6H_UFLOAT_BLOCK && vkf <= VK_FORMAT_BC7_SRGB_BLOCK);
